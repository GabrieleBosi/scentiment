{
  "expo": {
    "name": "Scentiment",
    "slug": "scentiment",
    "version": "0.1.0",
    "scheme": "scentiment",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scentiment.app"
    },
    "android": {
      "package": "com.scentiment.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scentiment uses the camera to photograph your meal.",
          "photosPermission": "Scentiment uses your photo library so you can attach a picture of your meal."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9683F"
        }
      ]
    ],
    "description": "A personal smell diary. Photograph each meal and write what it smells like."
  }
}
